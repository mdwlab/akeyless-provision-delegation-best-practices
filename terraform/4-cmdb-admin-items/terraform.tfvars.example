# Use the cmdb_admin persona's own API key here (from global-admin's
# `terraform output -json persona_credentials` -> .cmdb_admin), not the
# account admin key.
akeyless_access_id  = "p-xxxxxxxxxxxxxx"
akeyless_access_key = "REPLACE_ME"

akeyless_api_gateway_address = "https://gw-condor.mdwlab.org/api/v2"

base_path = "/xcorp"
region    = "cn"

# From cmdb-admin-targets' target_names output.
target_name = "/xcorp/cn/targets/condor_self_rotate_target"
